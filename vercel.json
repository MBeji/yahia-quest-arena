{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-vercel.mjs",
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "codex/**": false,
      "copilot/**": false,
      "dependabot/**": false,
      "wip/**": false,
      "draft/**": false,
      "rescue/**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/notify",
      "schedule": "0 18 * * *"
    }
  ]
}
