{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "GENERATED by `npm run harness:sync` from harness/policy.json (permissions) + the hooks wired in scripts/harness/sync.mjs. DO NOT EDIT BY HAND — edit the source and re-run the sync (étude 25 D-4).",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test)",
      "Bash(npm outdated:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx supabase migration list:*)",
      "Bash(npx supabase db diff:*)",
      "Bash(npx supabase test db)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git worktree list)",
      "Bash(ls:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git merge origin/main)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret list:*)",
      "Bash(gh variable set:*)",
      "Bash(gh variable list:*)",
      "Bash(npm install:*)",
      "Bash(node scripts/:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(nl:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow run rollback-prod.yml:*)",
      "Bash(gh workflow run db-backup.yml:*)",
      "Bash(gh workflow run db-tests.yml:*)",
      "Bash(gh workflow run apply-content.yml:*)",
      "Bash(gh workflow run apply-content-test.yml:*)",
      "Bash(gh workflow run e2e-auth.yml:*)",
      "Bash(gh workflow run ci.yml:*)",
      "Bash(gh workflow run migration-gate.yml:*)",
      "Bash(gh workflow run codeql.yml:*)",
      "Bash(gh workflow run nightly.yml:*)",
      "Bash(gh workflow run e2e.yml:*)",
      "Bash(gh workflow run perf.yml:*)",
      "Bash(gh workflow run freeze-watch.yml:*)",
      "Bash(gh workflow run regression-guard.yml:*)",
      "Bash(gh workflow run report-triage.yml:*)",
      "Bash(gh workflow run checkpoint-tag.yml:*)",
      "Bash(gh workflow run second-opinion.yml:*)",
      "Bash(gh workflow run guard-watch.yml:*)",
      "Bash(gh workflow run upgrade-guard.yml:*)",
      "Bash(gh workflow run auto-pr.yml:*)"
    ],
    "deny": [
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase db reset:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)",
      "Bash(gh workflow run db-migrate-prod.yml:*)",
      "Bash(gh workflow run release.yml:*)",
      "Bash(node scripts/db/push-prod.mjs:*)",
      "Bash(gh secret delete:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-generated.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "node .claude/hooks/precommit-checks.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-changed.mjs"
          }
        ]
      }
    ]
  }
}
